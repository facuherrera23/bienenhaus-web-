{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "staticDistDir": "./dist",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --disable-gpu --headless=new --disable-extensions --disable-software-rasterizer",
        "maxWaitForFcp": 60000,
        "maxWaitForLoad": 90000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "categories:accessibility": ["warn", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "csp-xss": ["off"],
        "errors-in-console": ["warn"],
        "non-composited-animations": ["off"],
        "total-byte-weight": ["off"],
        "bootup-time": ["off"],
        "dom-size": ["warn", { "maxNumeric": 1500 }],
        "render-blocking-resources": ["warn"],
        "uses-long-cache-ttl": ["warn"],
        "uses-text-compression": ["off"],
        "largest-contentful-paint": ["warn", { "maxNumeric": 4000 }],
        "cumulative-layout-shift": ["warn", { "maxNumeric": 0.25 }],
        "total-blocking-time": ["warn", { "maxNumeric": 500 }],
        "interactive": ["off"],
        "server-response-time": ["off"],
        "redirects": ["warn"],
        "uses-rel-preconnect": ["warn"],
        "viewport": ["error"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
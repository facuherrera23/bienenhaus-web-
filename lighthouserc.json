{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "./dist/index.html",
        "./dist/admin.html"
      ],
      "settings": {
        "preset": "desktop",
        "staticDistDir": "./dist",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --disable-gpu --headless=new --disable-extensions --disable-software-rasterizer",
        "maxWaitForFcp": 60000,
        "maxWaitForLoad": 90000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6 }],
        "categories:accessibility": ["error", { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.85 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 4000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 5000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.3 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "interactive": ["error", { "maxNumericValue": 5000 }],
        "server-response-time": ["error", { "maxNumericValue": 600 }],
        "redirects": ["off"],
        "uses-rel-preconnect": ["off"],
        "uses-text-compression": ["warn"],
        "viewport": ["error"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
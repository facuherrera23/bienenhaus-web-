# Bienenhaus - Variables de entorno
# Copia este archivo a .env.local y completa los valores

# Supabase (obligatorio)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANONIMA

# Cloudinary (obligatorio para subir imagenes)
VITE_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME

# Admin
VITE_ADMIN_EMAIL=admin@bienenhaus.com.ar

# WhatsApp (formato: 549XXXXXXXXXX)
VITE_WHATSAPP_NUMBER=5493511234567

# Feature flags
VITE_ENABLE_ADMIN=false

# Analytics (opcional)
VITE_GA4_ID=
VITE_META_PIXEL_ID=

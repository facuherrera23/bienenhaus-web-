# ================================================================
# VARIABLES DE ENTORNO - Bienenhaus Propiedades
# COPIA ESTE ARCHIVO A .env.local Y COMPLETA CON TUS VALORES REALES
# NO COMITEAR .env.local
# ================================================================

# -----------------------------------------------------------------------------
# SUPABASE (OBLIGATORIO)
# Obtén en: Supabase Dashboard > Settings > API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-aqui
# Service Role Key - SOLO para Edge Functions (NUNCA en frontend)
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# -----------------------------------------------------------------------------
# CLOUDINARY (OBLIGATORIO para subir imágenes)
# Dashboard > Settings > Upload > Upload presets (crear dos "unsigned")
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name
# Crea dos presets unsigned en Cloudinary:
# 1. Nombre: inmoconecta_propiedades → Folder: inmoconecta/propiedades
# 2. Nombre: inmoconecta_agentes → Folder: inmoconecta/agentes
CLOUDINARY_UPLOAD_PRESET_PROPS=inmoconecta_propiedades
CLOUDINARY_UPLOAD_PRESET_AGENTES=inmoconecta_agentes
# API Key/Secret - SOLO para Edge Functions (upload desde servidor)
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# -----------------------------------------------------------------------------
# MERCADOLIBRE OAUTH (OBLIGATORIO para integración ML)
# Crea app en: https://aplicaciones.mercadolibre.com.ar/
# Redirect URI: https://tu-proyecto.supabase.co/functions/v1/ml-oauth-callback
# -----------------------------------------------------------------------------
ML_APP_ID=123456789
ML_CLIENT_SECRET=tu-client-secret
ML_REDIRECT_URI=https://tu-proyecto.supabase.co/functions/v1/ml-oauth-callback
# Credenciales de test (opcional - para desarrollo)
# ML_TEST_USER_ID=123456789
# ML_TEST_ACCESS_TOKEN=APP_USR-xxxxx

# -----------------------------------------------------------------------------
# ANALYTICS & TRACKING (OBLIGATORIO para producción)
# -----------------------------------------------------------------------------
# Google Analytics 4
VITE_GA4_ID=G-XXXXXXXXXX
# Meta Pixel (Facebook)
VITE_META_PIXEL_ID=123456789012345

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING (RECOMENDADO)
# Obtén DSN en: sentry.io > Settings > Projects > Client Keys (DSN)
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=Bienenhaus Propiedades

# -----------------------------------------------------------------------------
# WHATSAPP (número en formato internacional SIN + ni espacios)
# Ejemplo Argentina Córdoba: 5493511234567
# -----------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=5493511234567

# -----------------------------------------------------------------------------
# ADMIN PANEL
# -----------------------------------------------------------------------------
VITE_ADMIN_EMAIL=admin@bienenhaus.com.ar
VITE_ENABLE_ADMIN=true

# -----------------------------------------------------------------------------
# FEATURE FLAGS (opcional)
# -----------------------------------------------------------------------------
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ML_SYNC=true
VITE_ENABLE_CHAT=false

# ================================================================
# NOTAS IMPORTANTES:
# ================================================================
# 1. Variables con VITE_ se exponen al frontend (import.meta.env.VITE_*)
# 2. Variables SIN prefijo VITE_ solo están en Edge Functions (Deno.env.get())
# 3. NUNCA pongas secrets reales en .env.example ni en repo
# 4. En producción: configura en Supabase Dashboard > Edge Functions > Secrets
# 5. Para ML OAuth: el redirect URI DEBE coincidir exactamente en ML y Supabase
# ================================================================
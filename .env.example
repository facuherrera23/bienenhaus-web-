# Supabase (obligatorio)
# Obtén en: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# Cloudinary (obligatorio para subir imágenes)
# Cloud Name: jpyigjrh
# API Key: 434774982616342
# API Secret: uxkT-y9ltMwPj21XVUgMaooSqx0
VITE_CLOUDINARY_CLOUD_NAME=jpyigjrh
# Crea dos presets "unsigned" en Cloudinary Dashboard > Settings > Upload:
# 1. Nombre: inmoconecta_propiedades → Unsigned → Folder: inmoconecta/propiedades
# 2. Nombre: inmoconecta_agentes → Unsigned → Folder: inmoconecta/agentes

# WhatsApp (número en formato internacional sin + ni espacios)
